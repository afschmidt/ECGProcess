<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <xs:element name="CardiologyXML">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="ObservationType" type="xs:string"/>
                <xs:element name="ObservationDateTime">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="Hour" type="xs:int"/>
                            <xs:element name="Minute" type="xs:int"/>
                            <xs:element name="Second" type="xs:int"/>
                            <xs:element name="Day" type="xs:int"/>
                            <xs:element name="Month" type="xs:int"/>
                            <xs:element name="Year" type="xs:int"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="UID">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="DICOMStudyUID" type="xs:string"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="ClinicalInfo">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="ReasonForStudy" type="xs:string" minOccurs="0"/>
                            <xs:element name="Technician">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="FamilyName" type="xs:string" minOccurs="0"/>
                                        <xs:element name="GivenName" type="xs:string" minOccurs="0"/>
                                        <xs:element name="PersonID" type="xs:string" minOccurs="0"/>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="ObservationComment" type="xs:string" minOccurs="0"/>
                            <xs:element name="DeviceInfo">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="Desc" type="xs:string"/>
                                        <xs:element name="SoftwareVer" type="xs:string"/>
                                        <xs:element name="AnalysisVer" type="xs:string"/>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="PatientVisit">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="PatientClass" type="xs:string"/>
                            <xs:element name="AssignedPatientLocation">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="Facility" type="xs:string" minOccurs="0"/>
                                        <xs:element name="LocationNumber" type="xs:int"/>
                                        <xs:element name="LocationName" type="xs:string"/>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="PatientRoom" type="xs:string" minOccurs="0"/>
                            <xs:element name="AdmissionType" type="xs:string"/>
                            <xs:element name="OrderingProvider">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="FamilyName" type="xs:string" minOccurs="0"/>
                                        <xs:element name="GivenName" type="xs:string" minOccurs="0"/>
                                        <xs:element name="PersonID" type="xs:string" minOccurs="0"/>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="AttendingDoctor">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="FamilyName" type="xs:string" minOccurs="0"/>
                                        <xs:element name="GivenName" type="xs:string" minOccurs="0"/>
                                        <xs:element name="PersonID" type="xs:string" minOccurs="0"/>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="ReferringDoctor">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="FamilyName" type="xs:string" minOccurs="0"/>
                                        <xs:element name="GivenName" type="xs:string" minOccurs="0"/>
                                        <xs:element name="PersonID" type="xs:string" minOccurs="0"/>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="ServicingFacility">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="Name" type="xs:string" minOccurs="0"/>
                                        <xs:element name="Address">
                                            <xs:complexType>
                                                <xs:sequence>
                                                    <xs:element name="Street1" type="xs:string" minOccurs="0"/>
                                                    <xs:element name="City" type="xs:string" minOccurs="0"/>
                                                </xs:sequence>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="SysBP" type="xs:string" minOccurs="0">
                                <xs:attribute name="units" type="xs:string" use="required"/>
                            </xs:element>
                            <xs:element name="DiaBP" type="xs:string" minOccurs="0">
                                <xs:attribute name="units" type="xs:string" use="required"/>
                            </xs:element>
                            <xs:element name="MedicalHistory">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="MedicalHistoryText" type="xs:string" minOccurs="0"/>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="OrderNumber" type="xs:string" minOccurs="0"/>
                            <xs:element name="Medications">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="Drug" type="xs:string" minOccurs="0"/>
                                        <xs:element name="Dosage" type="xs:string" minOccurs="0"/>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="ExtraQuestions">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="Label" type="xs:string" minOccurs="0">
                                            <xs:attribute name="Type" type="xs:string" use="required"/>
                                        </xs:element>
                                        <xs:element name="Content" type="xs:string" minOccurs="0"/>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <!-- Additional elements like PatientInfo, FilterSetting, Device-Type, Interpretation, and RestingECGMeasurements would follow similar structure -->
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>

