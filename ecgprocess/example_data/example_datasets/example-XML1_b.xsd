<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <xs:element name="CardiologyXML">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="ObservationType" type="xs:string"/>
                <xs:element name="ObservationDateTime">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="Hour" type="xs:int"/>
                            <xs:element name="Minute" type="xs:int"/>
                            <xs:element name="Second" type="xs:int"/>
                            <xs:element name="Day" type="xs:int"/>
                            <xs:element name="Month" type="xs:int"/>
                            <xs:element name="Year" type="xs:int"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="UID">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="DICOMStudyUID" type="xs:string"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <!-- ClinicalInfo and PatientVisit structures -->
                <xs:element name="PatientInfo">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="PID" type="xs:string"/>
                            <xs:element name="Name">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="FamilyName" type="xs:string"/>
                                        <xs:element name="GivenName" type="xs:string"/>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="Age" type="xs:int">
                                <xs:attribute name="units" type="xs:string" use="required"/>
                            </xs:element>
                            <xs:element name="BirthDateTime">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="Day" type="xs:int"/>
                                        <xs:element name="Month" type="xs:int"/>
                                        <xs:element name="Year" type="xs:int"/>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="Gender" type="xs:string"/>
                            <xs:element name="Race" type="xs:string"/>
                            <xs:element name="Height" type="xs:decimal">
                                <xs:attribute name="units" type="xs:string" use="required"/>
                            </xs:element>
                            <xs:element name="Weight" type="xs:decimal">
                                <xs:attribute name="units" type="xs:string" use="required"/>
                            </xs:element>
                            <xs:element name="PaceMaker" type="xs:string"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="FilterSetting">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="CubicSpline" type="xs:string"/>
                            <xs:element name="Filter50Hz" type="xs:string"/>
                            <xs:element name="Filter60Hz" type="xs:string"/>
                            <xs:element name="LowPass" type="xs:decimal">
                                <xs:attribute name="units" type="xs:string" use="required"/>
                            </xs:element>
                            <xs:element name="HighPass" type="xs:decimal">
                                <xs:attribute name="units" type="xs:string" use="required"/>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="Device-Type" type="xs:int"/>
                <xs:element name="Interpretation">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="Diagnosis">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="DiagnosisText" type="xs:string" maxOccurs="unbounded"/>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="Conclusion">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="ConclusionText" type="xs:string" maxOccurs="unbounded"/>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="RestingECGMeasurements">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="DiagnosisVersion" type="xs:string"/>
                            <xs:element name="VentricularRate" type="xs:int">
                                <xs:attribute name="units" type="xs:string" use="required"/>
                            </xs:element>
                            <xs:element name="PQInterval" type="xs:int">
                                <xs:attribute name="units" type="xs:string" use="required"/>
                            </xs:element>
                            <xs:element name="PDuration" type="xs:int">
                                <xs:attribute name="units" type="xs:string" use="required"/>
                            </xs:element>
                            <xs:element name="QRSDuration" type="xs:int">
                                <xs:attribute name="units" type="xs:string" use="required"/>
                            </xs:element>
                            <xs:element name="QTInterval" type="xs:int">
                                <xs:attribute name="units" type="xs:string" use="required"/>
                            </xs:element>
                            <xs:element name="QTCInterval" type="xs:int">
                                <xs:attribute name="units" type="xs:string" use="required"/>
                            </xs:element>
                            <xs:element name="RRInterval" type="xs:int">
                                <xs:attribute name="units" type="xs:string" use="required"/>
                            </xs:element>
                            <xs:element name="PPInterval" type="xs:int">
                                <xs:attribute name="units" type="xs:string" use="required"/>
                            </xs:element>
                            <xs:element name="SokolovLVHIndex" type="xs:string" minOccurs="0">
                                <xs:attribute name="units" type="xs:string" use="optional"/>
                            </xs:element>
                            <xs:element name="PAxis" type="xs:int">
                                <xs:attribute name="units" type="xs:string" use="required"/>
                            </xs:element>
                            <xs:element name="RAxis" type="xs:int">
                                <xs:attribute name="units" type="xs:string" use="required"/>
                            </xs:element>
                            <xs:element name="TAxis" type="xs:int">
                                <xs:attribute name="units" type="xs:string" use="required"/>
                            </xs:element>
                            <xs:element name="QTDispersion" type="xs:string" minOccurs="0">
                                <xs:attribute name="units" type="xs:string" use="optional"/>
                            </xs:element>
                            <xs:element name="QTDispersionBazett" type="xs:string" minOccurs="0">
                                <xs:attribute name="units" type="xs:string" use="optional"/>
                            </xs:element>
                            <xs:element name="QRSNum" type="xs:int"/>
                            <xs:element name="MeasurementTable">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="LeadOrder" type="xs:string"/>
                                        <xs:element name="QDuration" type="xs:string">
                                            <xs:attribute name="units" type="xs:string" use="required"/>
                                        </xs:element>
                                        <xs:element name="RDuration" type="xs:string">
                                            <xs:attribute name="units" type="xs:string" use="required"/>
                                        </xs:element>
                                        <xs:element name="SDuration" type="xs:string" minOccurs="0">
                                            <xs:attribute name="units" type="xs:string" use="optional"/>
                                        </xs:element>
                                        <xs:element name="RpDuration" type="xs:string" minOccurs="0">
                                            <xs:attribute name="units" type="xs:string" use="optional"/>
                                        </xs:element>
                                        <xs:element name="PAmplitude" type="xs:string">
                                            <xs:attribute name="units" type="xs:string" use="required"/>
                                        </xs:element>
                                        <xs:element name="QAmplitude" type="xs:string">
                                            <xs:attribute name="units" type="xs:string" use="required"/>
                                        </xs:element>
                                        <xs:element name="RAmplitude" type="xs:string">
                                            <xs:attribute name="units" type="xs:string" use="required"/>
                                        </xs:element>
                                        <xs:element name="SAmplitude" type="xs:string" minOccurs="0">
                                            <xs:attribute name="units" type="xs:string" use="optional"/>
                                        </xs:element>
                                        <xs:element name="TAmplitude" type="xs:string">
                                            <xs:attribute name="units" type="xs:string" use="required"/>
                                        </xs:element>
                                    </xs:sequence>
                                    <xs:attribute name="Creation" type="xs:string" use="required"/>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="POnset" type="xs:int">
                                <xs:attribute name="units" type="xs:string" use="required"/>
                            </xs:element>
                            <xs:element name="POffset" type="xs:int">
                                <xs:attribute name="units" type="xs:string" use="required"/>
                            </xs:element>
                            <xs:element name="QOnset" type="xs:int">
                                <xs:attribute name="units" type="xs:string" use="required"/>
                            </xs:element>
                            <xs:element name="QOffset" type="xs:int">
                                <xs:attribute name="units" type="xs:string" use="required"/>
                            </xs:element>
                            <xs:element name="TOffset" type="xs:int">
                                <xs:attribute name="units" type="xs:string" use="required"/>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>

