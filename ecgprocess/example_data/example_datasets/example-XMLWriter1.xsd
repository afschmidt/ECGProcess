<?xml version="1.0"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:complexType name="LeadGroupType">
    <xs:sequence>
      <xs:element name="Lead" maxOccurs="unbounded">
        <xs:complexType>
          <xs:simpleContent>
            <xs:extension base="xs:string">
              <xs:attribute name="name" type="xs:string" use="required"/>
            </xs:extension>
          </xs:simpleContent>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="ECGExport">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="SamplingFrequency" type="xs:decimal"/>
        <xs:element name="WaveForms" type="LeadGroupType"/>
        <xs:element name="MedianBeats" type="LeadGroupType"/>
      </xs:sequence>
      <xs:attribute name="id" type="xs:string" use="required"/>
      <xs:attribute name="schemaVersion" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
