[MetaData]
# Privileged tags
unique identifier				SOP Class UID
number of leads					Waveform Sequence_0.Number of Waveform Channels
resolution unit (waveforms)			Waveform Sequence_0.Channel Definition Sequence_0.Channel Sensitivity Units Sequence_0.Code Value
resolution (waveforms)				Waveform Sequence_0.Channel Definition Sequence_0.Channel Sensitivity
resolution unit (medianbeats)			Waveform Sequence_1.Channel Definition Sequence_0.Channel Sensitivity Units Sequence_0.Code Value
resolution (medianbeats)			Waveform Sequence_1.Channel Definition Sequence_0.Channel Sensitivity
sampling frequency (original)			Waveform Sequence_0.Sampling Frequency
sampling number (waveforms)			Waveform Sequence_0.Number of Waveform Samples
sampling number (medianbeats)			Waveform Sequence_1.Number of Waveform Samples
# baseline and correction information
baseline (waveforms)				Waveform Sequence_0.Channel Definition Sequence_0.Channel Baseline
correction factor (waveforms)			Waveform Sequence_0.Channel Definition Sequence_0.Channel Sensitivity Correction Factor
baseline (medianbeats)				Waveform Sequence_1.Channel Definition Sequence_0.Channel Baseline
correction factor (medianbeats)			Waveform Sequence_1.Channel Definition Sequence_0.Channel Sensitivity Correction Factor
# Dates and times
study date					Study Date
content date					Content Date
cruve date					Curve Date
start date					Acquisition DateTime
# Patient information
patient identifier				Patient ID
gender						Patient's Sex
birthday					Patient's Birth Date
height						Patient's Size
weight						Patient's Weight
# Also see how to extract this
cubicspline					FilterSetting.CubicSpline
filter50hz					FilterSetting.Filter50Hz
filter60hz					FilterSetting.Filter60Hz
lowpass unit					FilterSetting.LowPass.@units
lowpass						FilterSetting.LowPass.#text
highpass unit					FilterSetting.HighPass.@units
highpass					FilterSetting.HighPass.#text
